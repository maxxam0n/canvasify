{
	"name": "@maxxam0n/canvasify-vue",
	"private": false,
	"version": "0.2.0",
	"description": "Vue components for Canvasify",
	"keywords": [
		"canvas",
		"vue",
		"vue3",
		"html5-canvas",
		"declarative",
		"shapes",
		"layers",
		"components",
		"typescript"
	],
	"author": "maxxam0n",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maxxam0n/canvasify.git",
		"directory": "packages/vue"
	},
	"homepage": "https://github.com/maxxam0n/canvasify#readme",
	"bugs": {
		"url": "https://github.com/maxxam0n/canvasify/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false,
	"type": "module",
	"main": "./dist/canvasify-vue.umd.cjs",
	"module": "./dist/canvasify-vue.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/canvasify-vue.es.js",
			"require": "./dist/canvasify-vue.umd.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"type-check": "tsc -b",
		"lint": "eslint \"**/*.{ts,tsx,vue}\"",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"vue": ">=3.5.0"
	},
	"dependencies": {
		"@maxxam0n/canvasify-core": "^0.2.0"
	}
}
