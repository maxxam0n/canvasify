{
	"name": "@maxxam0n/canvasify-core",
	"private": false,
	"version": "0.2.0",
	"description": "Core rendering engine for Canvasify",
	"keywords": [
		"canvas",
		"html5-canvas",
		"rendering",
		"shapes",
		"layers",
		"declarative",
		"graphics",
		"2d",
		"typescript",
		"framework-agnostic"
	],
	"author": "maxxam0n",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maxxam0n/canvasify.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/maxxam0n/canvasify#readme",
	"bugs": {
		"url": "https://github.com/maxxam0n/canvasify/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": [
		"./dist/canvasify-render-worker.js"
	],
	"type": "module",
	"main": "./dist/canvasify-core.umd.cjs",
	"module": "./dist/canvasify-core.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/canvasify-core.es.js",
			"require": "./dist/canvasify-core.umd.cjs"
		},
		"./render-worker": {
			"default": "./dist/canvasify-render-worker.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && vite build --config vite.worker.config.ts",
		"type-check": "tsc --noEmit",
		"lint": "eslint \"**/*.{ts,tsx,vue}\"",
		"prepack": "npm run build"
	}
}
