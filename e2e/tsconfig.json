{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "@playwright/test"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": false,
		"isolatedModules": true
	},
	"include": ["./**/*.ts", "../playwright.config.ts"]
}
