{
	"name": "canvasify-workspace",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/*",
		"dev/*"
	],
	"scripts": {
		"build": "npm run --workspaces build",
		"dev:core": "npm run dev --workspace=dev-core",
		"dev:react": "npm run dev --workspace=dev-react",
		"dev:vue": "npm run dev --workspace=dev-vue",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:package": "node scripts/test-package.mjs",
		"pack:release": "node scripts/test-package.mjs --output-directory=release-artifacts",
		"test:watch": "vitest",
		"type-check": "npm run type-check:e2e && npm run --workspaces type-check",
		"type-check:e2e": "tsc --noEmit --project e2e/tsconfig.json",
		"audit": "npm audit --omit=dev --audit-level=high",
		"lint": "npm run lint:root && npm run --workspaces lint",
		"lint:root": "eslint \"scripts/**/*.mjs\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"vitest.config.ts\"",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"check": "npm run format:check && npm run lint && npm run build && npm run type-check && npm run test:coverage && npm run test:package && npm run test:e2e && npm run audit"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@microsoft/api-extractor": "^7.57.0",
		"@playwright/test": "1.62.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^24.0.7",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/coverage-v8": "^4.1.10",
		"@vue/language-core": "^3.1.5",
		"@vue/test-utils": "^2.4.11",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"eslint-plugin-vue": "^10.7.0",
		"globals": "^16.2.0",
		"jsdom": "^27.4.0",
		"postcss": "^8.5.24",
		"prettier": "^3.8.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.34.1",
		"vite": "^8.1.5",
		"unplugin-dts": "^1.0.3",
		"vitest": "^4.1.10",
		"vue": "^3.5.27",
		"vue-eslint-parser": "^10.2.0"
	}
}
